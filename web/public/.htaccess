# Servidor Apache de cPanel para el build de Astro (web/dist).
# Astro genera cada página como ruta.html (build.format: 'file') y las URLs
# públicas no llevan .html ni diagonal final: /contacto -> contacto.html.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Archivos ocultos (.git, .env...) nunca se sirven, salvo .well-known
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

    # /ruta.html -> /ruta (una sola URL por página)
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # /ruta/ -> /ruta cuando no es una carpeta real
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # /ruta -> ruta.html si existe
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Archivos con hash en el nombre: se guardan un año
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # Páginas: siempre se revalidan para que un despliegue se vea de inmediato
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
