---
// Sección 2 de Inicio (#39): agricultura impulsada por datos.
import Picture from '../ui/Picture.astro';
import parcelas from '../../assets/inicio/parcelas.jpg';

const chips = ['Drones multiespectrales', 'Sensores en campo', 'Análisis con inteligencia artificial'];
---
<section id="datos" class="px-5 py-24 md:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
    <div data-reveal>
      <p class="pa-eyebrow">La nueva era de la agricultura</p>
      <h2 class="pa-h2 mt-3">Agricultura impulsada por datos</h2>
      <p class="mt-6 text-lg leading-relaxed text-bosque/75">Trabajamos con los productores para llevar la agricultura al siguiente nivel, implementando los conocimientos de la química agrícola combinada con la aplicación de la última tecnología, redes remotas y sistemas de monitoreo por medio de drones y sensores, que te ayudará a administrar de manera más eficiente tus cultivos.</p>
      <ul class="mt-8 flex flex-wrap gap-2.5" data-reveal-stagger>
        {chips.map((chip) => <li class="rounded-full border border-[#d6efdc] bg-brote px-4 py-2 text-sm font-medium">{chip}</li>)}
      </ul>
    </div>
    <figure class="datos-figure" data-reveal>
      <Picture src={parcelas} alt="Vista satelital de parcelas agrícolas junto a un cuerpo de agua" sizes="(min-width: 1024px) 560px, 100vw" widths={[480, 800, 1120, 1600]} class="aspect-[4/3] w-full rounded-[28px] object-cover" />
      <span class="datos-scan" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<style>
  .datos-figure { position: relative; margin: 0; border-radius: 28px; box-shadow: 0 30px 60px rgb(26 60 42 / .18); overflow: hidden; }
  /* Una línea de escaneo cruza la imagen, como una pasada de dron. */
  .datos-scan { position: absolute; inset: 0 auto 0 0; width: 30%; background: linear-gradient(90deg, transparent, rgb(106 191 69 / .28) 80%, rgb(185 240 154 / .9) 100%); mix-blend-mode: screen; transform: translateX(-110%); animation: datos-scan 5.5s cubic-bezier(.65, 0, .35, 1) 1s infinite; pointer-events: none; }
  @keyframes datos-scan { 0% { transform: translateX(-110%); } 55%, 100% { transform: translateX(340%); } }
  @media (prefers-reduced-motion: reduce) { .datos-scan { display: none; } }
</style>
