---
// Cierre de Inicio: «Explora tu proyecto de biofábrica» (partial seo/recursos),
// ahora en tarjetas con flecha. Mismos enlaces y textos.
const links = [
  { href: '/biorreactores', label: 'Biorreactores agrícolas', note: 'Equipos y monitoreo IoT' },
  { href: '/biofabrica-on-farm', label: 'Guía de biofábricas en el rancho', note: 'Producción de bioinsumos on-farm' },
  { href: '/kit-biorreactor', label: 'Ficha técnica del kit', note: 'Componentes del kit' },
  { href: '/biofabrica', label: 'Calcula tu ahorro y solicita cotización', note: 'Cotización a tu medida', featured: true },
];
---
<nav class="bg-brote px-5 py-20 md:py-24" aria-labelledby="explora-titulo">
  <div class="mx-auto max-w-6xl">
    <h2 id="explora-titulo" class="pa-h2 max-w-xl" data-reveal>Explora tu proyecto de biofábrica</h2>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {links.map((link) => (
        <li>
          <a href={link.href} class:list={['explora__card', { 'is-featured': link.featured }]}>
            <span class="explora__label">{link.label}</span>
            <span class="explora__note">{link.note}</span>
            <span class="explora__arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .explora__card { position: relative; display: flex; flex-direction: column; height: 100%; padding: 24px; border-radius: 24px; background: #fff; border: 1px solid rgb(26 60 42 / .08); text-decoration: none; transition: transform .35s var(--ease-out-soft), box-shadow .35s, border-color .35s; }
  .explora__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); border-color: rgb(106 191 69 / .5); }
  .explora__label { font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; line-height: 1.25; letter-spacing: -.01em; }
  .explora__note { margin-top: 8px; font-size: 14px; color: rgb(26 60 42 / .65); }
  .explora__arrow { display: grid; place-items: center; width: 44px; height: 44px; margin-top: auto; border-radius: 50%; background: var(--color-brote); color: var(--color-hoja); transition: background .3s, color .3s, transform .35s var(--ease-out-soft); }
  .explora__card:hover .explora__arrow { background: var(--color-lima); color: var(--color-tinta); transform: translateX(4px); }
  .explora__note { margin-bottom: 20px; }
  @media (min-width: 640px) { .explora__card { min-height: 190px; } }
  .explora__card.is-featured { background: var(--color-bosque); color: #fff; border-color: transparent; }
  .explora__card.is-featured .explora__note { color: rgb(255 255 255 / .7); }
  .explora__card.is-featured .explora__arrow { background: var(--color-lima); color: var(--color-tinta); }
  @media (prefers-reduced-motion: reduce) { .explora__card, .explora__arrow { transition: none; } }
</style>
