---
// Sección 3 de Inicio: el proceso en tres pasos. La imagen fija muestra la misma
// huerta en tres capas (foto, índice y resultado); al llegar a cada paso, la capa
// nueva se abre con un círculo, como la lente de la portada. Sin JS o con
// movimiento reducido, se ve la primera capa y los tres pasos en lista.
import Picture from '../ui/Picture.astro';
import captura from '../../assets/inicio/proceso-captura.jpg';
import indice from '../../assets/inicio/proceso-indice.jpg';
import resultados from '../../assets/inicio/proceso-resultados.jpg';

const steps = [
  {
    title: 'Captura de información',
    text: 'Usamos imágenes satelitales, drones multiespectrales y termales, bitácoras de campo y apps de scouting.',
    layer: 'Captura aérea',
    image: captura,
    alt: 'Huerta en hileras fotografiada desde un dron',
    icon: 'M3 7h4l2-3h6l2 3h4v12H3z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',
  },
  {
    title: 'Procesamiento de datos',
    text: 'Procesamiento de información con uso de tecnologías que emplean inteligencia artificial y detección de patrones.',
    layer: 'Índice de vegetación',
    image: indice,
    alt: 'La misma huerta con el índice de vegetación: verde sano, amarillo y rojo con estrés',
    icon: 'M4 20V10 M10 20V4 M16 20v-7 M22 20H2',
  },
  {
    title: 'Presentación y resultados',
    text: 'Plataformas de análisis de resultados, mapas de aspersión para maquinaria agrícola y servicio de aspersión con drones.',
    layer: 'Mapa de resultados',
    image: resultados,
    alt: 'Mapa de resultados de la huerta con cada árbol clasificado por color',
    icon: 'M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z M9 4v14 M15 6v14',
  },
];
---
<section id="proceso" class="proceso bg-brote px-5 py-24 md:py-32">
  <div class="mx-auto max-w-6xl">
    <header class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="pa-eyebrow">Cómo trabajamos</p>
      <h2 class="pa-h2 mt-3">Nuestro proceso</h2>
      <p class="mt-5 text-lg leading-relaxed text-bosque/75">Tomamos cada proyecto a través de un proceso probado, diseñado para proporcionar los mejores resultados.</p>
    </header>

    <div class="proceso__grid">
      <div class="proceso__visual" data-reveal>
        <div class="proceso__frame">
          {steps.map((step, i) => (
            <div class="proceso__layer" data-layer={i} aria-hidden={i > 0 ? 'true' : undefined}>
              <Picture src={step.image} alt={i === 0 ? step.alt : ''} sizes="(min-width: 1024px) 560px, 100vw" widths={[480, 800, 1280]} class="h-full w-full object-cover" />
            </div>
          ))}
          <ol class="proceso__legend" aria-hidden="true">
            {steps.map((step, i) => <li data-dot={i}><span></span>{step.layer}</li>)}
          </ol>
        </div>
      </div>

      <ol class="proceso__steps">
        {steps.map((step, i) => (
          <li class="proceso__step" data-step={i} data-reveal>
            <div class="proceso__num" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={step.icon} /></svg>
            </div>
            <p class="proceso__index">Paso {i + 1}</p>
            <h3 class="proceso__title">{step.title}</h3>
            <p class="proceso__text">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('proceso');
  if (section && 'IntersectionObserver' in window) {
    const layers = section.querySelectorAll<HTMLElement>('[data-layer]');
    const dots = section.querySelectorAll<HTMLElement>('[data-dot]');
    const steps = section.querySelectorAll<HTMLElement>('[data-step]');
    const show = (n: number) => {
      layers.forEach((layer, i) => layer.classList.toggle('is-on', i <= n));
      dots.forEach((dot, i) => dot.classList.toggle('is-on', i === n));
      steps.forEach((step, i) => step.classList.toggle('is-current', i === n));
    };
    section.classList.add('is-live');
    show(0);
    // Las capas ocultas tras el recorte no se cargarían solas (lazy); se piden
    // cuando la sección se acerca a la pantalla.
    const preload = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      section.querySelectorAll<HTMLImageElement>('[data-layer] img').forEach((img) => (img.loading = 'eager'));
      preload.disconnect();
    }, { rootMargin: '100% 0px' });
    preload.observe(section);
    // El paso activo es el que cruza la franja central de la pantalla.
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) show(Number((entry.target as HTMLElement).dataset.step));
      }
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach((step) => observer.observe(step));
  }
</script>

<style>
  .proceso__grid { display: grid; gap: 40px; margin-top: 56px; }
  .proceso__visual { position: sticky; top: 76px; z-index: 1; }
  .proceso__frame { position: relative; aspect-ratio: 16 / 10; border-radius: 28px; overflow: hidden; background: var(--color-noche); box-shadow: 0 30px 60px rgb(26 60 42 / .2); }
  .proceso__layer { position: absolute; inset: 0; }
  .proceso__layer :global(picture) { display: block; height: 100%; }
  .proceso.is-live .proceso__layer { clip-path: circle(75% at 50% 50%); transition: clip-path 1.1s var(--ease-out-soft); }
  .proceso.is-live .proceso__layer:not(.is-on) { clip-path: circle(0% at 50% 50%); }
  .proceso__legend { position: absolute; left: 14px; bottom: 14px; z-index: 2; display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .proceso__legend li { display: flex; align-items: center; gap: 7px; padding: 7px 11px; border-radius: 999px; font-size: 12px; font-weight: 600; color: rgb(255 255 255 / .7); background: rgb(15 36 25 / .5); border: 1px solid rgb(255 255 255 / .18); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); transition: color .3s, background .3s; }
  .proceso__legend span { width: 7px; height: 7px; border-radius: 50%; background: currentColor; opacity: .6; }
  .proceso__legend li.is-on { color: var(--color-tinta); background: var(--color-lima); border-color: transparent; }

  .proceso__steps { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; counter-reset: paso; }
  .proceso__step { position: relative; padding: 28px; border-radius: 24px; background: #fff; border: 1px solid rgb(26 60 42 / .08); box-shadow: 0 1px 2px rgb(26 60 42 / .04); transition: box-shadow .4s, border-color .4s, transform .4s var(--ease-out-soft); }
  .proceso.is-live .proceso__step.is-current { border-color: rgb(106 191 69 / .55); box-shadow: var(--shadow-card); }
  .proceso__num { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--color-brote); color: var(--color-hoja); transition: background .4s, color .4s; }
  .proceso.is-live .proceso__step.is-current .proceso__num { background: var(--color-bosque); color: var(--color-lima); }
  .proceso__index { margin-top: 20px; font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-medio); }
  .proceso__title { margin-top: 6px; font-size: 1.5rem; font-weight: 800; }
  .proceso__text { margin-top: 10px; line-height: 1.7; color: rgb(26 60 42 / .75); }

  @media (min-width: 1024px) {
    .proceso__grid { grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: start; }
    .proceso__visual { top: 120px; }
    .proceso__frame { aspect-ratio: 4 / 3.4; }
    .proceso__steps { gap: 24px; padding: 8vh 0 18vh; }
    .proceso__step { min-height: 42vh; display: flex; flex-direction: column; justify-content: center; padding: 40px; }
    .proceso.is-live .proceso__step:not(.is-current) { opacity: .55; }
  }
  @media (max-width: 1023px) {
    /* En celular la imagen se queda arriba, más baja, y los pasos pasan debajo. */
    .proceso__frame { aspect-ratio: 16 / 9; }
    .proceso__visual { top: 72px; }
    .proceso__steps { padding-bottom: 8vh; }
    .proceso__step { min-height: 34vh; }
  }
  @media (max-width: 640px) {
    /* En celular solo la capa activa lleva nombre; las otras quedan como punto. */
    .proceso__legend li:not(.is-on) { gap: 0; padding: 7px; font-size: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .proceso.is-live .proceso__layer { transition: none; }
  }
</style>
