---
// Contacto: datos, WhatsApp con mensaje por servicio y mapa que se carga al pedirlo.
// Contenido de pages/contacto.htm con el H1 de #37 y los datos de #40. Sin formulario.
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import { CORREO, FACEBOOK, HORARIO, TELEFONO, TELEFONO_HREF, UBICACION, organizacion, whatsapp } from '../components/contacto/datos';

const MAPA_EMBED = 'https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d14924.409122745063!2d-103.5105917!3d20.7466481!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x5e119e1c386b0f4!2zUHJlY2lzacOzbiBBZ3LDrWNvbGE!5e0!3m2!1ses!2smx!4v1642982203057!5m2!1ses!2smx';
const MAPA_LINK = 'https://maps.google.com/?cid=423648297388257524';

const icon = {
  whatsapp: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z',
  telefono: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z',
  correo: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm18 2-10 7L2 6',
  ubicacion: 'M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
};

const temas = [
  { label: 'Fumigación con drones', texto: 'Hola, quiero cotizar fumigación con drones.' },
  { label: 'Biorreactores agrícolas', texto: 'Hola, quiero cotizar un biorreactor agrícola.' },
  { label: 'Mapas de fertilidad', texto: 'Hola, quiero cotizar mapas de fertilidad para mi parcela.' },
  { label: 'Venta o reparación de drones', texto: 'Hola, quiero información sobre venta o reparación de drones.' },
];
---
<BaseLayout
  title="Contacto | Precisión Agrícola — Cotiza Drones y Biorreactores Agrícolas"
  description="Contáctanos para cotizar fumigación con drones, biorreactores agrícolas IoT y mapas de fertilidad en Jalisco y Michoacán. Respuesta en 24 horas."
  ogTitle="Contacto | Precisión Agrícola"
  ogDescription="Cotiza fumigación con drones, biorreactores agrícolas y mapas de fertilidad. Respuesta en 24 horas."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contacto | Precisión Agrícola',
    url: 'https://www.precisionagricola.com/contacto',
    inLanguage: 'es-MX',
    about: {
      ...organizacion,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+52-33-1117-4441',
        email: CORREO,
        contactType: 'sales',
        areaServed: 'MX',
        availableLanguage: 'es',
        hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '08:00', closes: '17:00' },
      },
    },
  }}
>
  <Fragment slot="head">
    <meta name="geo.region" content="MX-JAL" />
    <meta name="geo.placename" content="Jalisco, México" />
    <link rel="preconnect" href="https://www.google.com" />
  </Fragment>

  <!-- Hero con curvas de nivel animadas y la tarjeta de WhatsApp. -->
  <section class="ct-hero relative isolate overflow-hidden bg-noche px-5 pt-36 pb-24 text-white md:pt-44 md:pb-32">
    <svg class="ct-hero__lines absolute inset-0 -z-10 h-full w-full" viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
      {Array.from({ length: 9 }, (_, i) => (
        <path
          d={`M-40 ${150 + i * 62} C 260 ${70 + i * 62}, 520 ${260 + i * 58}, 820 ${150 + i * 60} S 1300 ${40 + i * 66}, 1500 ${170 + i * 60}`}
          stroke="currentColor"
          stroke-width="1.2"
          style={`--i:${i}`}
        />
      ))}
    </svg>
    <div class="ct-hero__glow absolute -z-10" aria-hidden="true"></div>

    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="pa-eyebrow text-lima!" data-reveal>Contacto · Respuesta en 24 horas</p>
        <h1 class="pa-h1 mt-4" data-reveal>Contáctanos</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80 md:text-xl" data-reveal>
          Brindamos soluciones integrales para nuestros clientes por medio de la tecnología para el seguimiento de la evolución del cultivo.
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal>
          <Button href={whatsapp()} size="lg" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.whatsapp} /></svg>
            Escríbenos por WhatsApp
          </Button>
          <Button href={TELEFONO_HREF} variant="ghost-light" size="lg">Llamar al {TELEFONO}</Button>
        </div>
      </div>

      <div class="ct-pick rounded-[var(--radius-card)] border border-white/15 bg-white/[.06] p-7 backdrop-blur-xl md:p-8" data-reveal>
        <h2 class="font-display text-xl font-extrabold">¿Qué quieres cotizar?</h2>
        <p class="mt-1.5 text-sm text-white/65">Elige un tema y se abre WhatsApp con el mensaje listo.</p>
        <ul class="mt-6 space-y-2.5">
          {temas.map((t) => (
            <li>
              <a href={whatsapp(t.texto)} target="_blank" rel="noopener" class="ct-topic group flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/5 px-5 py-4 font-medium">
                {t.label}
                <svg class="shrink-0 text-lima transition-transform duration-300 group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Datos de contacto en tarjetas. -->
  <Section eyebrow="Datos de contacto" title="Hablemos de tu cultivo">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-[1fr_1.4fr_1fr_1fr]" data-reveal-stagger>
      <li class="ct-card rounded-[var(--radius-card)] border border-bosque/10 p-7">
        <span class="ct-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.telefono} /></svg></span>
        <h3 class="ct-card__label">Teléfono</h3>
        <p class="mt-1 text-lg font-bold"><a class="hover:text-hoja" href={TELEFONO_HREF}>{TELEFONO}</a></p>
      </li>
      <li class="ct-card rounded-[var(--radius-card)] border border-bosque/10 p-7">
        <span class="ct-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.correo} /></svg></span>
        <h3 class="ct-card__label">Correo electrónico</h3>
        <p class="mt-1 text-[15px] font-bold [overflow-wrap:anywhere]"><a class="hover:text-hoja" href={`mailto:${CORREO}`}>{CORREO}</a></p>
        <button type="button" class="ct-copy mt-3 text-sm font-bold text-hoja hover:underline" data-copy={CORREO} hidden>Copiar correo</button>
      </li>
      <li class="ct-card rounded-[var(--radius-card)] border border-bosque/10 p-7">
        <span class="ct-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.ubicacion} /></svg></span>
        <h3 class="ct-card__label">Ubicación</h3>
        <p class="mt-1 text-lg font-bold">{UBICACION}</p>
        <p class="mt-1 text-sm text-bosque/65">Servicio en Jalisco y Michoacán</p>
      </li>
      <li class="ct-card rounded-[var(--radius-card)] border border-bosque/10 p-7">
        <span class="ct-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
        <h3 class="ct-card__label">Horario</h3>
        <p class="mt-1 text-lg font-bold">{HORARIO}</p>
        <p class="mt-1 text-sm"><a class="font-bold text-hoja hover:underline" href={FACEBOOK} target="_blank" rel="noopener">Síguenos en Facebook</a></p>
      </li>
    </ul>
  </Section>

  <!-- Mapa: no carga Google Maps hasta que la persona lo pide. -->
  <section class="px-5 pb-24">
    <div class="ct-map relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-bosque text-white" data-reveal>
      <div class="ct-map__frame absolute inset-0" data-src={MAPA_EMBED}></div>
      <div class="ct-map__cover relative flex min-h-[420px] flex-col items-start justify-end gap-5 p-8 md:min-h-[480px] md:p-12">
        <span class="ct-map__pin" aria-hidden="true"></span>
        <div>
          <p class="pa-eyebrow text-lima!">Cómo llegar</p>
          <h2 class="pa-h2 mt-3">Precisión Agrícola, {UBICACION}</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button class="ct-map__load" size="lg">Mostrar mapa</Button>
          <Button href={MAPA_LINK} variant="ghost-light" size="lg" target="_blank" rel="noopener">Abrir en Google Maps</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Mapa bajo demanda: así Google Maps no pesa en la carga de la página.
  const map = document.querySelector<HTMLElement>('.ct-map');
  map?.querySelector('.ct-map__load')?.addEventListener('click', () => {
    const frame = map.querySelector<HTMLElement>('.ct-map__frame')!;
    const iframe = document.createElement('iframe');
    iframe.src = frame.dataset.src!;
    iframe.title = 'Mapa de Precisión Agrícola en Jalisco';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.allowFullscreen = true;
    frame.append(iframe);
    map.classList.add('is-loaded');
    iframe.focus();
  }, { once: true });

  // Copiar el correo, solo si el navegador lo permite.
  document.querySelectorAll<HTMLButtonElement>('.ct-copy').forEach((button) => {
    if (!navigator.clipboard) return;
    button.hidden = false;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      button.textContent = 'Correo copiado';
      setTimeout(() => (button.textContent = 'Copiar correo'), 2000);
    });
  });
</script>

<style>
  /* Curvas de nivel que se dibujan y ondulan despacio. */
  .ct-hero__lines { color: rgb(106 191 69 / .22); }
  .ct-hero__lines path {
    stroke-dasharray: 1800; stroke-dashoffset: 1800;
    animation: ct-draw 2.4s var(--ease-out-soft) calc(var(--i) * 120ms) forwards, ct-drift 14s ease-in-out calc(var(--i) * -1.4s) infinite alternate;
  }
  @keyframes ct-draw { to { stroke-dashoffset: 0; } }
  @keyframes ct-drift { to { transform: translateY(18px); } }

  .ct-hero__glow {
    width: 640px; height: 640px; right: -180px; top: -160px; border-radius: 50%;
    background: radial-gradient(circle, rgb(61 140 95 / .55), transparent 65%);
    animation: ct-glow 10s ease-in-out infinite alternate;
  }
  @keyframes ct-glow { to { transform: translate(-160px, 120px); } }

  .ct-topic { transition: background .25s, border-color .25s; }
  .ct-topic:hover { background: rgb(106 191 69 / .14); border-color: rgb(106 191 69 / .5); }

  .ct-card { transition: transform .35s var(--ease-out-soft), box-shadow .35s, border-color .35s; }
  .ct-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-card); border-color: rgb(106 191 69 / .5); }
  .ct-card__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: rgb(45 106 79 / .1); color: var(--color-hoja); transition: background .3s, color .3s; }
  .ct-card:hover .ct-card__icon { background: var(--color-lima); color: var(--color-tinta); }
  .ct-card__label { margin-top: 22px; font-family: var(--font-sans); font-size: .8125rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-medio); }

  /* Portada del mapa: retícula tipo plano con un pin que late. */
  .ct-map__cover {
    background:
      radial-gradient(circle at 72% 26%, rgb(106 191 69 / .25), transparent 40%),
      linear-gradient(rgb(255 255 255 / .06) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 255 255 / .06) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(to top, var(--color-noche), transparent 70%);
    transition: opacity .4s;
  }
  .ct-map__pin { position: absolute; left: 72%; top: 26%; width: 18px; height: 18px; margin: -9px; border-radius: 50%; background: var(--color-lima); box-shadow: 0 0 0 0 rgb(106 191 69 / .6); animation: ct-pulse 2.2s ease-out infinite; }
  @keyframes ct-pulse { to { box-shadow: 0 0 0 36px rgb(106 191 69 / 0); } }
  .ct-map__frame :global(iframe) { width: 100%; height: 100%; border: 0; }
  .ct-map.is-loaded .ct-map__cover { opacity: 0; pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .ct-hero__lines path { animation: none; stroke-dashoffset: 0; }
    .ct-hero__glow, .ct-map__pin { animation: none; }
    .ct-card, .ct-topic, .ct-map__cover { transition: none; }
  }
</style>
