---
// /drones: venta, reparación, servicio y asesoría de drones agrícolas DJI.
// Portada de themes/precision-agricola/pages/landing.htm (Bootstrap) con el
// título, la descripción, el H1 y los alt de #37.
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Picture from '../components/ui/Picture.astro';
import DroneIllustration from '../components/drones/DroneIllustration.astro';
import campo from '../assets/drones/campo.jpg';
import ndvi from '../assets/drones/ndvi.jpg';

const title = 'Fumigación con Drones Agrícolas | Precisión Agrícola — Jalisco y Michoacán';
const description = 'Servicio de fumigación de campos agrícolas con drones de precisión. Mapas de fertilidad y análisis georreferenciado en Jalisco y Michoacán.';
const og = await getImage({ src: campo, width: 1200, format: 'jpg' });
const phone = { href: 'tel:+523311174441', label: '(52) 33 1117 4441' };

const stats = [
  { value: 90, suffix: '%', label: 'menos agua por hectárea' },
  { value: 60, suffix: ' ha', label: 'de rendimiento por día' },
  { value: 10, suffix: ' min', label: 'para aplicar una hectárea' },
];

const services = [
  { id: 'venta', title: 'Venta', text: 'Drones agrícolas DJI Agriculture con el respaldo de un distribuidor autorizado, listos para tu cultivo.', icon: 'M3 7h18l-2 11H5L3 7Zm5 0V5a4 4 0 0 1 8 0v2' },
  { id: 'reparacion', title: 'Reparación', text: 'Diagnóstico, refacciones y puesta a punto de tu dron para que vuelva a volar sin perder la temporada.', icon: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4 2.5-2.5Z' },
  { id: 'servicio', title: 'Servicio de aspersión', text: 'Fumigamos tu parcela en Jalisco y Michoacán con la dosis exacta por hectárea, también de noche y en cerros.', icon: 'M12 3c3 4 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 3-7 6-11Z' },
  { id: 'asesoria', title: 'Asesoría', text: 'Te ayudamos a elegir el equipo, a planear las aplicaciones y a sacar provecho de los mapas del dron.', icon: 'M4 5h16v11H8l-4 4V5Zm4 5h8M8 13h5' },
];

const advantages = [
  'Aspersiones nocturnas',
  'Ahorro del 90% de agua',
  'Aplicaciones homogéneas',
  'Aplicaciones sin desperdicios',
  'Aplicaciones en suelos mojados',
  'Reduce costos de mano de obra',
  'Utiliza la dosis exacta por hectárea',
  'Reduce tiempos de aplicación',
  'Aplicaciones en cerros',
];

// Tabla de landing.htm. Las dos primeras columnas son la mochila (herbicida y foliar).
const methods = ['Mochila · herbicida', 'Mochila · foliar', 'Maquinaria agrícola', 'Dron de aspersión'];
const rows = [
  { label: 'Tipo de aplicación', cells: ['Herbicida', 'Foliar', 'Herbicida / Foliar', 'General'] },
  { label: 'Gasto de agua por hectárea', cells: ['100 L', '200 L', '300 L', '10 – 20 L'] },
  { label: 'Ancho de aspersión', cells: ['3.2 m', '1.6 m', '10.5 m', '5.0 – 9.0 m'] },
  { label: 'Tiempo de aplicación', cells: ['4 h', '7 h', '1 h', '10 min'] },
  { label: 'Condiciones de suelo', cells: ['Seco / Húmedo', 'Seco', 'Seco / Húmedo', 'No aplica'] },
  { label: 'Rendimiento por día', cells: ['1 ha', '1 ha', '20 ha', '60 ha'] },
  { label: 'Costo de aplicación', cells: ['$400', '$600', '$400', '$500'] },
];
// Las mismas cifras en barras, para leer la diferencia de un vistazo.
const charts = [
  { title: 'Agua por hectárea', unit: 'litros', max: 300, bars: [100, 200, 300, 20], labels: ['100 L', '200 L', '300 L', '10 – 20 L'] },
  { title: 'Tiempo por hectárea', unit: 'minutos', max: 420, bars: [240, 420, 60, 10], labels: ['4 h', '7 h', '1 h', '10 min'] },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Fumigación con drones agrícolas',
  serviceType: 'Aspersión agrícola con drones',
  description,
  url: 'https://www.precisionagricola.com/drones',
  areaServed: [
    { '@type': 'State', name: 'Jalisco' },
    { '@type': 'State', name: 'Michoacán' },
  ],
  provider: {
    '@type': 'Organization',
    name: 'Precisión Agrícola',
    url: 'https://www.precisionagricola.com',
    telephone: '+52 33 1117 4441',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Drones agrícolas DJI',
    itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, description: s.text } })),
  },
};
---
<BaseLayout title={title} description={description} image={og.src} jsonLd={jsonLd}>
  <!-- Hero: ortomosaico con zoom lento, dron animado y cifras clave. -->
  <section class="dr-hero relative isolate overflow-hidden bg-noche text-white">
    <div class="dr-hero__bg absolute inset-0 -z-10">
      <Picture src={campo} alt="" priority pictureClass="absolute inset-0" class="h-full w-full object-cover opacity-55" />
    </div>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_40%,transparent_0%,rgb(15_36_25/.55)_55%,rgb(15_36_25/.95)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-noche to-transparent"></div>

    <div class="mx-auto grid min-h-[100svh] max-w-7xl items-center gap-8 px-5 pt-32 pb-16 lg:grid-cols-[1.05fr_1fr] lg:pt-36">
      <div class="dr-hero__copy">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-bold tracking-[.14em] uppercase backdrop-blur-md">
          <span class="size-2 rounded-full bg-lima shadow-[0_0_12px_#6abf45]"></span>
          Distribuidor autorizado DJI Agriculture
        </p>
        <h1 class="pa-h1 mt-6 max-w-2xl">Drones agrícolas DJI: <span class="text-lima">venta, reparación, servicio y asesoría</span></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">{description}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/contacto" size="lg">Agenda una demostración</Button>
          <Button href={phone.href} variant="ghost-light" size="lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>
            Llamar
          </Button>
        </div>
      </div>

      <div class="dr-hero__drone relative mx-auto w-full max-w-[560px]">
        <div class="absolute inset-[12%] -z-10 rounded-full bg-lima/25 blur-3xl"></div>
        <DroneIllustration />
      </div>

      <dl class="grid grid-cols-3 gap-3 sm:gap-4 lg:col-span-2 lg:max-w-3xl" data-reveal-stagger>
        {stats.map((s) => (
          <div class="rounded-2xl border border-white/15 bg-white/[.07] p-4 backdrop-blur-md sm:p-5">
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-xl font-black whitespace-nowrap text-lima sm:text-4xl"><span data-count={s.value}>{s.value}</span>{s.suffix}</dd>
            <dd class="mt-1 text-xs leading-snug text-white/70 sm:text-sm" aria-hidden="true">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Servicios -->
  <Section id="servicios" eyebrow="Lo que hacemos" title="Todo para volar tu campo" lead="Del primer vuelo de prueba al mantenimiento de la temporada, un solo equipo te acompaña con tu dron agrícola.">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {services.map((s, i) => (
        <li id={s.id} class="dr-card group relative overflow-hidden rounded-[var(--radius-card)] border border-bosque/10 bg-white p-7 shadow-[var(--shadow-card)]">
          <span class="absolute top-6 right-7 font-display text-5xl font-black text-bosque/[.06]">0{i + 1}</span>
          <span class="grid size-14 place-items-center rounded-2xl bg-brote text-hoja transition-colors duration-300 group-hover:bg-lima group-hover:text-tinta">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
          </span>
          <h3 class="mt-6 text-xl font-extrabold">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-bosque/70">{s.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Ventajas -->
  <Section id="ventajas" tone="bosque" eyebrow="Ventajas" title="Ventajas de la aspersión con drones agrícolas">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {advantages.map((a) => (
        <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[.04] px-5 py-4 transition-colors duration-300 hover:border-lima/50 hover:bg-white/[.08]">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-lima text-tinta">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
          </span>
          <span class="font-semibold text-white/90">{a}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Comparación -->
  <Section id="comparacion" tone="brote" eyebrow="En números" title="Comparación de métodos de aspersión" lead="Lo que cuesta aplicar una hectárea con mochila, con maquinaria y con dron.">
    <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
      {charts.map((c) => (
        <figure class="dr-chart rounded-[var(--radius-card)] bg-white p-6 shadow-[var(--shadow-card)] sm:p-8">
          <figcaption class="flex items-baseline justify-between gap-4">
            <span class="font-display text-lg font-extrabold">{c.title}</span>
            <span class="text-sm text-bosque/50">{c.unit}</span>
          </figcaption>
          <ul class="mt-6 space-y-4">
            {c.bars.map((v, i) => (
              <li class="grid grid-cols-[8.5rem_1fr] items-center gap-3 text-sm sm:grid-cols-[10rem_1fr]">
                <span class:list={['leading-tight', i === 3 ? 'font-bold text-hoja' : 'text-bosque/70']}>{methods[i]}</span>
                <span class="flex items-center gap-2">
                  <span class:list={['dr-bar h-3 rounded-full', i === 3 ? 'bg-lima' : 'bg-bosque/20']} style={`--w:${Math.max((v / c.max) * 100, 3).toFixed(1)}%; --i:${i}`}></span>
                  <span class:list={['shrink-0 tabular-nums', i === 3 ? 'font-bold text-hoja' : 'text-bosque/60']}>{c.labels[i]}</span>
                </span>
              </li>
            ))}
          </ul>
        </figure>
      ))}
    </div>

    <div class="mt-8 overflow-hidden rounded-[var(--radius-card)] bg-white shadow-[var(--shadow-card)]" data-reveal>
      <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Tabla comparativa de métodos de aspersión">
        <table class="w-full min-w-[720px] border-collapse text-left text-sm">
          <caption class="sr-only">Comparación por hectárea: aplicación manual con mochila, maquinaria agrícola y dron de aspersión</caption>
          <thead>
            <tr class="bg-bosque text-white">
              <th scope="col" class="sticky left-0 bg-bosque px-5 py-4 font-semibold">Superficie: 1 hectárea</th>
              <th scope="colgroup" colspan="2" class="px-5 py-4 text-center font-semibold">Aplicación manual con mochila</th>
              <th scope="col" class="px-5 py-4 text-center font-semibold">Maquinaria agrícola</th>
              <th scope="col" class="bg-lima px-5 py-4 text-center font-extrabold text-tinta">Dron de aspersión</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-t border-bosque/10 transition-colors hover:bg-brote/60">
                <th scope="row" class="sticky left-0 bg-white px-5 py-4 font-semibold">{r.label}</th>
                {r.cells.map((cell, i) => (
                  <td class:list={['px-5 py-4 text-center tabular-nums', i === 3 ? 'bg-lima/10 font-bold text-hoja' : 'text-bosque/75']}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <!-- Mapas: el mismo huerto en color natural y en NDVI. -->
  <Section id="mapas" tone="noche" eyebrow="Antes de volar, medimos" title="Mapas de fertilidad y análisis georreferenciado" lead="Con vuelos multiespectrales vemos qué árboles necesitan atención y aplicamos solo donde hace falta. Desliza para comparar.">
    <figure class="dr-compare relative aspect-[4/3] overflow-hidden sm:aspect-[2560/1143] rounded-[var(--radius-card)] ring-1 ring-white/10" data-reveal style="--cut:50%">
      <Picture src={campo} alt="Huerto en hileras visto desde el dron en color natural" sizes="(min-width: 1152px) 1152px, 100vw" class="block h-full w-full object-cover" />
      <div class="dr-compare__top absolute inset-0">
        <Picture src={ndvi} alt="El mismo huerto en mapa NDVI: verde con vigor, rojo con estrés" sizes="(min-width: 1152px) 1152px, 100vw" class="h-full w-full object-cover" />
      </div>
      <div class="dr-compare__line pointer-events-none absolute inset-y-0" aria-hidden="true">
        <span class="absolute top-1/2 left-1/2 grid size-11 -translate-1/2 place-items-center rounded-full bg-white text-bosque shadow-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6" /></svg>
        </span>
      </div>
      <span class="absolute top-4 left-4 rounded-full bg-noche/70 px-3 py-1 text-xs font-bold tracking-wider uppercase backdrop-blur" aria-hidden="true">Color natural</span>
      <span class="absolute top-4 right-4 rounded-full bg-noche/70 px-3 py-1 text-xs font-bold tracking-wider text-lima uppercase backdrop-blur" aria-hidden="true">NDVI</span>
      <input class="dr-compare__range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" type="range" min="0" max="100" value="50" aria-label="Comparar color natural y NDVI" />
    </figure>
  </Section>

  <!-- Llamada a la acción -->
  <section class="relative overflow-hidden bg-lima px-5 py-20 text-tinta md:py-24">
    <div class="dr-cta__rings pointer-events-none absolute -right-24 -bottom-40 size-[34rem] rounded-full border-[3rem] border-white/20" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-[1.4fr_1fr]" data-reveal>
      <div>
        <h2 class="pa-h2">Ve un dron DJI trabajando en tu parcela</h2>
        <p class="mt-4 max-w-xl text-lg text-tinta/75">Agenda una demostración, pide la ficha técnica o llámanos al <span class="whitespace-nowrap">{phone.label}</span>.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
        <Button href="/contacto" variant="dark" size="lg">Agenda una demostración</Button>
        <Button href="/contacto" variant="outline" size="lg" class="border-tinta/30! text-tinta! hover:bg-white/30!">Pide la ficha técnica</Button>
        <Button href={phone.href} variant="outline" size="lg" class="border-tinta/30! text-tinta! hover:bg-white/30!">Llamar al {phone.label}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: zoom lento del ortomosaico y, donde se soporta, parallax al hacer scroll. */
  .dr-hero__bg { animation: dr-zoom 24s ease-in-out infinite alternate; }
  @keyframes dr-zoom { from { transform: scale(1.04); } to { transform: scale(1.14) translate(-1.5%, 1%); } }
  .dr-hero__copy > * { animation: dr-rise 0.9s var(--ease-out-soft) both; }
  .dr-hero__copy > :nth-child(2) { animation-delay: 0.08s; }
  .dr-hero__copy > :nth-child(3) { animation-delay: 0.16s; }
  .dr-hero__copy > :nth-child(4) { animation-delay: 0.24s; }
  .dr-hero__drone { animation: dr-fly-in 1.4s var(--ease-out-soft) 0.2s both; }
  @keyframes dr-rise { from { opacity: 0; transform: translateY(28px); } }
  @keyframes dr-fly-in { from { opacity: 0; transform: translate(18%, -12%) rotate(6deg); } }

  @supports (animation-timeline: scroll()) {
    .dr-hero__drone > :last-child {
      animation: dr-drift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 100svh;
    }
    @keyframes dr-drift { to { transform: translate(-12%, 30%) scale(.85); } }
  }

  /* Tarjetas de servicio: se elevan al pasar el cursor. */
  .dr-card { transition: transform 0.4s var(--ease-out-soft), box-shadow 0.4s var(--ease-out-soft); }
  .dr-card:hover { transform: translateY(-6px); box-shadow: 0 22px 44px rgb(26 60 42 / 0.16); }

  /* Barras: crecen cuando la tarjeta entra en pantalla. */
  .dr-bar {
    width: var(--w);
    transform-origin: left;
    transition: transform 1.1s var(--ease-out-soft);
    transition-delay: calc(var(--i) * 120ms + 250ms);
  }
  :global(.js) [data-reveal-stagger]:not(.is-visible) .dr-bar { transform: scaleX(0); }

  /* Comparador NDVI: la capa NDVI se recorta en --cut. */
  .dr-compare__top { clip-path: inset(0 0 0 var(--cut)); }
  .dr-compare__line { left: var(--cut); width: 2px; margin-left: -1px; background: #fff; }
  .dr-compare.is-animating .dr-compare__top { transition: clip-path 1.2s var(--ease-out-soft); }
  .dr-compare.is-animating .dr-compare__line { transition: left 1.2s var(--ease-out-soft); }
  .dr-compare__range:focus-visible ~ .dr-compare__line,
  .dr-compare:has(.dr-compare__range:focus-visible) .dr-compare__line { box-shadow: 0 0 0 3px var(--color-lima); }

  .dr-cta__rings { animation: dr-spin 30s linear infinite; border-style: dashed; }
  @keyframes dr-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .dr-hero__bg, .dr-hero__copy > *, .dr-hero__drone, .dr-hero__drone > :last-child, .dr-cta__rings { animation: none !important; }
    .dr-bar, .dr-card { transition: none; }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cifras del hero: cuentan desde 0 una vez que se ven. El valor final ya está en el HTML.
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const end = Number(el.dataset.count);
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / 1400, 1);
        el.textContent = String(Math.round(end * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0';
      setTimeout(() => requestAnimationFrame(tick), 500);
    });
  }

  // Comparador: barrido de entrada y luego control con el deslizador.
  const compare = document.querySelector<HTMLElement>('.dr-compare');
  const range = compare?.querySelector<HTMLInputElement>('.dr-compare__range');
  if (compare && range) {
    const set = (v: number) => compare.style.setProperty('--cut', `${v}%`);
    range.addEventListener('input', () => {
      compare.classList.remove('is-animating');
      set(Number(range.value));
    });
    if (!reduced && 'IntersectionObserver' in window) {
      set(88);
      const io = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        compare.classList.add('is-animating');
        requestAnimationFrame(() => set(Number(range.value)));
        setTimeout(() => compare.classList.remove('is-animating'), 1300);
      }, { threshold: 0.45 });
      io.observe(compare);
    }
  }
</script>
